# Copy to .env in this same directory and fill in real values.
# NEVER commit the real .env — it holds live write credentials.

DOMAIN_NAME=srv1536619.hstgr.cloud

ODOO_URL=https://pnyssen-synapsys-odoo.odoo.com
ODOO_DB=pnyssen-synapsys-odoo-production-27407175
ODOO_LOGIN=phil@synapsys.com.au
ODOO_API_KEY=

N8N_URL=https://n8n.srv1536619.hstgr.cloud
N8N_API_TOKEN=

# Two DISTINCT secrets, not one shared token — so revoking/rotating one
# doesn't require touching the other. Generate each ON THE VPS, e.g.:
#   openssl rand -hex 32
# so the value only ever exists on the server, never pasted into chat.
MCP_AUTH_TOKEN_ODOO=
MCP_AUTH_TOKEN_N8N=

# Browser-facing origins allowed to POST back during the OAuth consent step
# (both service domains, comma-separated, full https:// scheme required).
MCP_ALLOWED_ORIGINS=https://odoo-mcp.srv1536619.hstgr.cloud,https://n8n-mcp.srv1536619.hstgr.cloud

# Entra OAuth — optional, blank = bearer-only.
ENTRA_TENANT_ID=
ODOO_OAUTH_CLIENT_ID=
ODOO_OAUTH_CLIENT_SECRET=
ODOO_MCP_API_AUDIENCE=
N8N_OAUTH_CLIENT_ID=
N8N_OAUTH_CLIENT_SECRET=
N8N_MCP_API_AUDIENCE=

# backup_vps.sh (restic). Local path works but doesn't survive this VPS
# failing — point at s3:/b2:/sftp: for real offsite backup. See that
# script's header comment and SECRETS_INDEX.md for RESTIC_PASSWORD.
RESTIC_REPOSITORY=/var/backups/mcp-vps-restic
RESTIC_PASSWORD=
