<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Enable review extension: one Mesh, six heading peers; Architecture/35 existing leaves remain untouched. -->
  <!-- Verb catalogue views disable writes in UI only; backend ACL is unchanged. -->
  <record id="view_peer_verb_list_enable" model="ir.ui.view">
    <field name="name">synapsys.verb.peer.enable.list</field>
    <field name="model">synapsys.verb</field>
    <field name="arch" type="xml"><list create="0" edit="0" delete="0" import="0"><field name="name"/><field name="plane"/><field name="action"/><field name="direction"/><field name="authority_requirement"/><field name="human_only"/><field name="grammar_status"/></list></field>
  </record>
  <menuitem id="menu_peer_form_enable" name="Form" parent="menu_root" sequence="4"/>
  <record id="action_peer_orient_enable" model="ir.actions.act_window">
    <field name="name">Orient</field><field name="res_model">synapsys.verb</field>
    <field name="view_mode">list</field><field name="domain">[('action', '=', 'Orient')]</field>
    <field name="context">{}</field>
    <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_peer_verb_list_enable')})]"/>
  </record>
  <menuitem id="menu_peer_form_orient_enable" name="Orient" parent="menu_peer_form_enable" sequence="1" action="action_peer_orient_enable"/>
