<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="res.groups.privilege" id="privilege_synapsys">
        <field name="name">SynapSys</field>
        <field name="sequence">5</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>
    <record id="group_synapsys_user" model="res.groups">
        <field name="name">Collaborator</field>
        <field name="comment">Reads the Mesh and works on Outcomes, Signals and evidence.</field>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="privilege_synapsys"/>
    </record>
    <record id="group_synapsys_steward" model="res.groups">
        <field name="name">Steward</field>
        <field name="comment">Rules Contexts, verbs, chains, Services, Methods and canon; accepts Benefits.</field>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_synapsys_user'))]"/>
        <field name="privilege_id" ref="privilege_synapsys"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="strategy_label_steward_live" model="synapsys.strategy.group.label"><field name="audience">steward</field><field name="group">live</field><field name="sequence">1</field><field name="label">Live</field></record>
    <record id="strategy_label_steward_build" model="synapsys.strategy.group.label"><field name="audience">steward</field><field name="group">build</field><field name="sequence">2</field><field name="label">Build</field></record>
    <record id="strategy_label_steward_adapt" model="synapsys.strategy.group.label"><field name="audience">steward</field><field name="group">adapt</field><field name="sequence">3</field><field name="label">Adapt</field></record>
    <record id="strategy_label_deliver_live" model="synapsys.strategy.group.label"><field name="audience">deliver</field><field name="group">live</field><field name="sequence">1</field><field name="label">Live</field></record>
    <record id="strategy_label_deliver_build" model="synapsys.strategy.group.label"><field name="audience">deliver</field><field name="group">build</field><field name="sequence">2</field><field name="label">Deliver</field></record>
    <record id="strategy_label_deliver_adapt" model="synapsys.strategy.group.label"><field name="audience">deliver</field><field name="group">adapt</field><field name="sequence">3</field><field name="label">Adapt</field></record>
</odoo>
