@@ -0,0 +1,331 @@
+"""Screen declarations and the screen projection (RC06a, source-only candidate).
+
+Pure functions: no Odoo, no writes, no sudo, no I/O except loading the declaration file by path.
+
+A screen is DECLARED as data (data/screen_declarations.json) and PROJECTED here into one depth-limited model, which
+screen_render.render_screen turns into HTML. No screen has its own slot code.
+
+Rulings relied on (Steward, 27 Nov 2026, in chat; none is canon):
+  1 stage sets the ceiling, you drill within it; stage is computed from the bound kind at render time and never stored
+  2 two screen types: noun (full ladder, no stage) and record (ceiling from its kind)
+  3 one question per depth   4 fixed frame   5 trust table   6 declared as data   7 frame first, verbs separately
+  8 Stage and Depth are two separate labels.
+Content is never invented: every claim reads from the registry element it is bound to, every source chip must quote text
+the registry element actually holds (a chip whose quote is absent is dropped and noted), and a missing value says so.
+"""
+import hashlib
+import json
+import os
+
+try:  # inside Odoo
+    from . import scaffold_lens as sl
+except ImportError:  # offline tests load modules by path
+    import scaffold_lens as sl
+
+DEPTHS = sl.DEPTHS  # ("enable", "enhance", "enrich")
+NOT_BOUND = "not bound"
+STAGE_BY_KIND = {"K-1": "enable", "K-3": "enable", "K-4": "enable", "K-6": "enhance", "K-8": "enhance", "K-12": "enrich"}
+SCREEN_TYPES = ("noun", "record")
+KNOWN_SLOTS = {
+    "enable": ("header", "answer", "trust", "movement"),
+    "enhance": ("made_of", "peers"),
+    "enrich": ("trust_table", "open_questions", "technical"),
+}
+FRAME = KNOWN_SLOTS["enable"]
+NOT_APPLICABLE = "Not applicable for this kind"
+DEFAULT_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "data", "screen_declarations.json")
+STEM_MAX = 60
+
+
+# ---------------------------------------------------------------------------------------------------------- stage
+def stage_for_kind(kind):
+    """Pure. kind -> 'enable' | 'enhance' | 'enrich' | 'not bound'. Unknown or missing kind is NOT bound, never guessed."""
+    k = kind.strip() if isinstance(kind, str) else None
+    return STAGE_BY_KIND.get(k, NOT_BOUND)
+
+
+def ceiling_for_stage(stage):
+    """Deepest depth a record screen may show. An unbound stage is Enable depth only."""
+    return stage if stage in DEPTHS else "enable"
+
+
+def _ix(depth):
+    return DEPTHS.index(depth)
+
+
+def resolve_depth(screen_type, requested, stage=None, role_effective=None):
+    """Returns (effective, clamped, reason). Noun screens never clamp for stage; role clamping still applies.
+
+    role_effective is the depth the actor's role allows (already <= requested). A record screen then also applies the
+    stage ceiling. depth_clamped is True whenever effective != requested, with the reason named."""
+    if requested not in DEPTHS:
+        raise ValueError("unknown depth %r" % (requested,))
+    eff = role_effective if role_effective in DEPTHS else requested
+    reason = "role" if eff != requested else None
+    if screen_type == "record":
+        ceil = ceiling_for_stage(stage)
+        if _ix(ceil) < _ix(eff):
+            eff, reason = ceil, "stage"
+    return eff, eff != requested, reason
+
+
+# ----------------------------------------------------------------------------------------------------- declaration
+def declaration_sha(raw_bytes):
+    return hashlib.sha256(raw_bytes).hexdigest()
+
+
+def validate_screen(d):
+    """Returns a list of error strings; empty means valid."""
+    errs = []
+    sid = d.get("id", "?")
+
+    def bad(msg):
+        errs.append("%s: %s" % (sid, msg))
+
+    for k in ("id", "noun", "screen_type", "title", "answer", "trust_claim", "movement", "claims"):
+        if k not in d:
+            bad("missing %s" % k)
+    if errs:
+        return errs
+    if d["screen_type"] not in SCREEN_TYPES:
+        bad("screen_type must be noun or record")
+    rec = d.get("record")
+    if d["screen_type"] == "record":
+        if not isinstance(rec, dict) or not rec.get("model") or not rec.get("name_field"):
+            bad("a record screen must declare record.model and record.name_field")
+        else:
+            kd = rec.get("kind")
+            if not isinstance(kd, dict) or (("field" in kd) == ("fixed" in kd)):
+                bad("a record screen must declare record.kind as exactly one of field or fixed")
+            elif "fixed" in kd and kd["fixed"] not in STAGE_BY_KIND:
+                bad("record.kind.fixed %r is not a known kind" % (kd["fixed"],))
+    elif rec is not None:
+        bad("a noun screen has no record block and no stage")
+    if d["answer"].get("from") != "element.definition":
+        bad("answer.from must be element.definition (no invented text)")
+    mv = d["movement"]
+    if not isinstance(mv.get("verbs"), list):
+        bad("movement.verbs must be a list (empty allowed)")
+    else:
+        for v in mv["verbs"]:
+            if not (isinstance(v, dict) and v.get("verb") and v.get("source") and v.get("status") == "bound"):
+                bad("a verb appears only where bound: verb, source and status 'bound' are required (no proposed or candidate verbs)")
+    if not mv.get("verbs") and not mv.get("hold_reason"):
+        bad("movement.hold_reason is required where no verb is bound")
+    ids = []
+    for c in d["claims"]:
+        for k in ("id", "type", "noun", "label", "sources"):
+            if k not in c:
+                bad("claim missing %s" % k)
+        ids.append(c.get("id"))
+        if c.get("type") not in ("element", "peer"):
+            bad("claim %s: type must be element or peer" % c.get("id"))
+        for s in c.get("sources", []):
+            if not (s.get("name") and s.get("quote")) or "date" not in s:
+                bad("claim %s: a source needs name, date (null if the registry text holds none) and quote" % c.get("id"))
+    if len(set(ids)) != len(ids):
+        bad("duplicate claim ids")
+    if d["trust_claim"] not in ids:
+        bad("trust_claim %r is not a claim id" % (d["trust_claim"],))
+    mo = d.get("made_of")
+    if mo is not None and not (mo.get("relationship") and mo.get("heading") and isinstance(mo.get("role_names"), dict)):
+        bad("made_of needs relationship, heading and role_names")
+    pe = d.get("peers")
+    if pe is not None:
+        if not (pe.get("heading") and isinstance(pe.get("nouns"), list)) or len(pe["nouns"]) > 3:
+            bad("peers needs heading and at most three nouns")
+        else:
+            peer_claims = {c["noun"] for c in d["claims"] if c.get("type") == "peer"}
+            for n in pe["nouns"]:
+                if n not in peer_claims:
+                    bad("peer %s has no peer claim for the trust table" % n)
+            for n in peer_claims - set(pe["nouns"]):
+                bad("peer claim for %s is not in peers.nouns" % n)
+    elif any(c.get("type") == "peer" for c in d["claims"]):
+        bad("a peer claim needs a peers block")
+    return errs
+
+
+def load_declarations(path=None):
+    """Returns ({id: screen}, meta). Raises ValueError listing every error; never returns a half-valid set."""
+    p = path or DEFAULT_PATH
+    with open(p, "rb") as fh:
+        raw = fh.read()
+    doc = json.loads(raw.decode("utf-8"))
+    errs = []
+    if doc.get("schema") != "synapsys.screen.declaration/1":
+        errs.append("unknown schema %r" % (doc.get("schema"),))
+    slots = doc.get("slots")
+    if slots != {k: list(v) for k, v in KNOWN_SLOTS.items()}:
+        errs.append("slots per depth must be exactly %s" % json.dumps(KNOWN_SLOTS))
+    out = {}
+    for s in doc.get("screens", []):
+        errs.extend(validate_screen(s))
+        out[s.get("id")] = s
+    if errs:
+        raise ValueError("; ".join(errs))
+    return out, {"sha256": declaration_sha(raw), "slots": slots}
+
+
+# --------------------------------------------------------------------------------------------------- projection
+def stem_of(text):
+    """One-line stem of an open question: up to the first ( : or ? and at most STEM_MAX chars. Returns (stem, truncated)."""
+    t = " ".join(str(text).split())
+    cut = len(t)
+    for ch in ("(", ":", "?"):
+        i = t.find(ch)
+        if 0 < i < cut:
+            cut = i
+    s = t[:min(cut, STEM_MAX)].rstrip(" ,;")
+    return s, len(s) < len(t)
+
+
+def _chips(claim, element, notes):
+    """Source chips for a claim. A chip whose quote is absent from the registry text is dropped and noted, never shown."""
+    src = (element or {}).get("definition_source") or ""
+    out = []
+    for s in claim.get("sources", []):
+        if s["quote"] in src:
+            out.append({"name": s["name"], "date": s.get("date")})
+        else:
+            notes.append("%s: source chip %r not found in the registry text" % (claim["id"], s["name"]))
+    return out
+
+
+def _kind_of(decl, record):
+    """Returns (kind_or_None, reason_or_None, neighbour_kind) for a record screen."""
+    kd = decl["record"]["kind"]
+    nb = (record or {}).get("neighbour_kind") or None
+    if "fixed" in kd:
+        return kd["fixed"], None, nb
+    k = (record or {}).get("kind")
+    if not k:
+        return None, "this record has no resolved kind", nb
+    if k not in STAGE_BY_KIND:
+        return None, "kind %s is not one of K-1, K-3, K-4, K-6, K-8, K-12" % k, nb
+    return k, None, nb
+
+
+def _slots_for(depth):
+    out = []
+    for d in DEPTHS[:_ix(depth) + 1]:
+        out.extend(KNOWN_SLOTS[d])
+    return out
+
+
+def project(decl, reg, requested_depth, actor, evidence, library_index, context_id="", role_max_depth=None, record=None):
+    """Declaration + registry + actor -> depth-limited screen model (a dict). No I/O, no writes.
+
+    Only content the actor is entitled to, at the effective depth, is put in the model (the same model is the JSON route
+    output, so there is no hidden page data). Evidence passes the existing fail-closed filters in scaffold_lens."""
+    if requested_depth not in DEPTHS:
+        return {"result": "REFUSED", "reason": "UNKNOWN_DEPTH"}
+    els = sl.index_registry(reg)
+    noun = decl["noun"]
+    if noun not in els:
+        return {"result": "REFUSED", "reason": "UNKNOWN_NOUN"}
+    role_eff = sl._effective_depth(actor or {}, requested_depth, role_max_depth)
+    if role_eff is None:
+        return {"result": "REFUSED", "reason": "NO_RECOGNISED_ROLE"}
+    stype = decl["screen_type"]
+    stage = stage_reason = neighbour = None
+    kind = None
+    if stype == "record":
+        kind, stage_reason, neighbour = _kind_of(decl, record)
+        stage = stage_for_kind(kind)
+        if stage == NOT_BOUND and not stage_reason:
+            stage_reason = "kind not bound"
+    eff, clamped, clamp_reason = resolve_depth(stype, requested_depth, stage, role_eff)
+    el = els[noun]
+    notes = []
+    claims = {c["id"]: c for c in decl["claims"]}
+    chips = {cid: _chips(c, els.get(c["noun"]), notes) for cid, c in claims.items()}
+    tc = claims[decl["trust_claim"]]
+    mv = decl["movement"]
+    out = {
+        "result": "OK", "screen": decl["id"], "screen_type": stype, "noun": noun, "title": decl["title"],
+        "label": el["label"], "status": el.get("status"), "definition": el.get("definition"),
+        "registry_version": reg.get("version"),
+        "stage": stage, "stage_reason": stage_reason, "stage_computed_not_stored": True,
+        "depth_requested": requested_depth, "depth_effective": eff, "depth_clamped": clamped, "clamp_reason": clamp_reason,
+        "context_id": context_id, "writes": 0,
+        "slots": _slots_for(eff),
+        "frame": {
+            "header": {"noun": el["label"], "status": el.get("status"), "record_name": (record or {}).get("name") if stype == "record" else None,
+                       "neighbour_kind": neighbour},
+            "answer": el.get("definition"),
+            "trust": {"status": el.get("status"), "source_count": len(chips[tc["id"]])},
+            "movement": ({"state": "BOUND", "verbs": [v["verb"] for v in mv["verbs"]]} if mv["verbs"]
+                         else {"state": "HOLD", "text": "verbs not yet bound", "reason": mv["hold_reason"], "verbs": []}),
+        },
+        "notes": notes,
+    }
+    if eff != requested_depth and clamp_reason == "stage":
+        out["not_applicable"] = {"requested": requested_depth, "text": NOT_APPLICABLE if stage != NOT_BOUND else "Stage not bound: Enable depth only",
+                                 "reason": stage_reason if stage == NOT_BOUND else "stage %s sets the ceiling" % stage}
+    peers = []
+    if _ix(eff) >= 1:
+        mo = decl.get("made_of")
+        roles = sl.roles_for(reg, els, mo["relationship"]) if mo else []
+        enh = {"made_of": {"heading": mo["heading"], "relationship": mo["relationship"], "rows": [
+            {"role_id": r["role_id"], "name": mo["role_names"].get(r["role_id"]) or _fallback_role(r), "required": r["required"],
+             "many": r["many"], "bound_label": r["bound_label"], "bound_status": r["bound_status"], "cluster_id": r["cluster_id"]}
+            for r in roles]} if mo else None}
+        pd = decl.get("peers")
+        if pd:
+            for pn in pd["nouns"]:
+                peers.append(sl._peer_block(els, pn, eff, actor, evidence, library_index, context_id))
+            enh["peers"] = {"heading": pd["heading"], "rows": [
+                {"id": p["id"], "label": p["label"], "status": p["status"], "operating_source": p.get("operating_source"),
+                 "definition": p.get("definition")} for p in peers]}
+        else:
+            enh["peers"] = None
+        out["enhance"] = enh
+    if _ix(eff) >= 2:
+        rows = []
+        for c in decl["claims"]:
+            e = els.get(c["noun"]) or {}
+            row = {"id": c["id"], "label": c["label"], "chips": chips[c["id"]], "source_count": len(chips[c["id"]]),
+                   "full_citation": e.get("definition_source"), "evidence": [], "rejected": []}
+            oqs = list(e.get("open_questions") or [])
+            if c["type"] == "element":
+                row["status"] = e.get("status")
+                row["qualifier"] = None
+                if c.get("qualifier_from") == "element.kind":
+                    k = e.get("kind")
+                    row["qualifier"] = {"first": ("Kind: " + str(k).split(";")[0]) if k else None, "full": k}
+            else:
+                p = [x for x in peers if x["id"] == c["noun"]][0]
+                row["registry_status"] = p.get("status")
+                sourced = p.get("operating_source") == "SOURCED"
+                row["status"] = "CATALOGUE RECORD FOUND" if sourced else "HOLD"
+                quals = []
+                for ev in p.get("evidence") or []:
+                    quals.extend((ev.get("detail") or {}).get("qualifiers") or [])
+                    row["evidence"].append({"label": ev.get("label"), "source_ref": ev.get("source_ref"), "sha256": ev.get("sha256")})
+                    row["chips"] = [{"name": str(ev.get("label") or ev.get("source_ref")).split(" ")[0], "date": None, "evidence": True}] + row["chips"]
+                    row["source_count"] += 1
+                row["rejected"] = sorted(set(r.get("reason", "") for r in p.get("rejected_evidence") or []))
+                row["qualifier"] = ({"first": quals[0], "full": quals} if quals else
+                                    {"first": "No operating source: HOLD", "full": None} if not sourced else None)
+            row["open"] = []
+            for q in oqs:
+                s, trunc = stem_of(q)
+                row["open"].append({"text": q, "stem": s, "truncated": trunc})
+            rows.append(row)
+        out["enrich"] = {
+            "rows": rows,
+            "open_total": sum(len(r["open"]) for r in rows),
+            "technical": {
+                "registry_version": reg.get("version"), "relationship": (decl.get("made_of") or {}).get("relationship"),
+                "cluster_id": (out["enhance"]["made_of"]["rows"][0]["cluster_id"] if out["enhance"]["made_of"] and out["enhance"]["made_of"]["rows"] else None),
+                "evidence_sources": [{"source_ref": e["source_ref"], "sha256": e["sha256"]} for r in rows for e in r["evidence"]],
+                "screen_id": decl["id"], "kind": kind,
+            },
+        }
+    return out
+
+
+def _fallback_role(r):
+    t = str(r.get("role_label") or r.get("role_id") or "").replace("_", " ").replace("+", "").strip()
+    return (t[:1].upper() + t[1:]) if t else "Role"
diff -ruN a/synapsys/screen_render.py b/synapsys/screen_render.py
--- a/synapsys/screen_render.py	1970-01-01 00:00:00.000000000 +0000
+++ b/synapsys/screen_render.py	2026-11-27 03:38:00.492595113 +0000
@@ -0,0 +1,230 @@
+"""The one screen renderer (RC06a, source-only candidate).
+
+Builds the fixed frame (header, answer, trust line, movement) and the depth sections from a screen model produced by
+screen_decl.project. There is no per-screen rendering code: every slot is built by one generic function, in declared order.
+Pure: every dynamic value is escaped; no scripts, no inline event handlers, no external URLs. Presentation only: it changes no
+data, kind, PPV, approval or right.
+"""
+from html import escape as _e
+
+STYLE = ('<style>.syn-sc{max-width:1100px;margin:0 auto;padding:16px 16px 48px;color:#1f2933;box-sizing:border-box}'
+         '.syn-sc *{box-sizing:border-box}.syn-sc h1{font-size:24px;margin:0 0 4px}.syn-sc h2{font-size:17px;margin:20px 0 8px}'
+         '.syn-sc .sb{color:#52606d;font-size:14px;margin:0 0 12px;overflow-wrap:anywhere}'
+         '.syn-sc .lb{font-size:13px;color:#52606d;margin:0 0 8px}.syn-sc .lb span{margin-right:12px}'
+         '.syn-sc .an{font-size:15px;margin:0 0 8px;overflow-wrap:anywhere}.syn-sc .tl,.syn-sc .mv{font-size:14px;margin:0 0 8px;overflow-wrap:anywhere}'
+         '.syn-sc a.bk{display:inline-block;min-height:44px;line-height:44px;padding:0 14px;margin:0 0 8px -14px;color:#714b67;cursor:pointer}'
+         '.syn-sc .cd{background:#fff;border:1px solid #e4e7eb;border-radius:10px;padding:14px 16px;margin:0 0 14px}'
+         '.syn-sc .kv{display:flex;justify-content:space-between;gap:12px;font-size:13px;padding:6px 0;border-top:1px solid #f0f2f5}'
+         '.syn-sc .kv span:first-child{color:#7b8794;min-width:30%}.syn-sc .kv span:last-child{text-align:right;overflow-wrap:anywhere}'
+         '.syn-sc .tg{display:inline-block;font-size:12px;padding:1px 8px;border-radius:6px;background:#f0f4ff;color:#3e4c59;margin-right:4px}'
+         '.syn-sc .hold{background:#fff4e5;color:#7a4b00}.syn-sc .req{background:#e6f4ea;color:#14532d}'
+         '.syn-sc ul{margin:4px 0;padding-left:18px}.syn-sc .kv ul{margin:0;text-align:left}.syn-sc li{overflow-wrap:anywhere}.syn-sc .nt{font-size:12px;color:#7b8794;margin-top:14px}'
+         '.syn-sc table.tt{width:100%;border-collapse:collapse;font-size:13px;table-layout:fixed}.syn-sc .tt th,.syn-sc .tt td{text-align:left;vertical-align:top;padding:6px 8px;border-top:1px solid #f0f2f5;overflow-wrap:anywhere}'
+         '.syn-sc .tt td>div{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.syn-sc .tt details>div{white-space:normal}'
+         '.syn-sc details summary{cursor:pointer;color:#714b67;font-size:12px}'
+         '@media (max-width:600px){.syn-sc .kv{flex-direction:column;gap:2px}.syn-sc .kv span:last-child{text-align:left}.syn-sc .tt th:nth-child(3),.syn-sc .tt td:nth-child(3){display:none}}</style>')
+
+BACK = '<a class="bk" data-lv="1" data-g="">&larr; Lenses</a>'
+DEPTH_NOTE = {'enable': 'Enable: what this is, and what to do next. Switch Depth to Enhance for what it is made of and connects to, Enrich for trust and what is open.',
+              'enhance': 'Enhance: what it is made of, and what it connects to.',
+              'enrich': 'Enrich: why to trust it, and what is still open.'}
+LABEL = {'enable': 'Enable', 'enhance': 'Enhance', 'enrich': 'Enrich'}
+NO_ROLES = 'No roles are declared for this screen.'
+
+
+def _t(v):
+    return _e(str(v)) if v not in (None, '', [], ()) else 'UNSOURCED'
+
+
+def _kv(k, v):
+    return '<div class="kv"><span>%s</span><span>%s</span></div>' % (_e(str(k)), v)
+
+
+def _pill(text, cls=''):
+    return '<span class="tg%s">%s</span>' % ((' ' + cls) if cls else '', _e(str(text)))
+
+
+def _plural(n, word):
+    return '%d %s' % (n, word if n == 1 else word + 's')
+
+
+def _chip_text(c):
+    return ('%s %s' % (c['name'], c['date'])) if c.get('date') else c['name']
+
+
+# ------------------------------------------------------------------------------------------------ frame slots
+def _slot_header(m):
+    h = m['frame']['header']
+    title = h['noun'] if not h.get('record_name') else '%s: %s' % (h['noun'], h['record_name'])
+    if m['screen_type'] == 'noun':
+        stage = 'Stage: none (a noun screen has no stage)'
+    elif m['stage'] == 'not bound':
+        stage = 'Stage: not bound'
+    else:
+        stage = 'Stage: %s' % LABEL[m['stage']]
+    s = '<div data-slot="header"><h1>%s %s</h1>' % (_e(title), _pill(h.get('status') or 'UNSOURCED'))
+    s += '<p class="lb"><span data-label="stage">%s</span><span data-label="depth">Depth: %s</span>' % (_e(stage), _e(LABEL[m['depth_effective']]))
+    if h.get('neighbour_kind'):
+        s += '<span data-label="neighbour">Neighbour: its Context is kind %s (shown, never used for stage)</span>' % _e(str(h['neighbour_kind']))
+    s += '</p>'
+    if m['screen_type'] == 'record' and m['stage'] == 'not bound':
+        s += '<p class="sb" data-slot-note="stage">Stage not bound: %s.</p>' % _e(str(m.get('stage_reason') or 'kind not bound'))
+    return s + '</div>'
+
+
+def _slot_answer(m):
+    return '<p class="an" data-slot="answer">%s</p>' % _t(m['frame']['answer'])
+
+
+def _slot_trust(m):
+    t = m['frame']['trust']
+    return '<p class="tl" data-slot="trust">%s %s</p>' % (_pill(t['status'] or 'UNSOURCED'), _e(_plural(t['source_count'], 'source')))
+
+
+def _slot_movement(m):
+    mv = m['frame']['movement']
+    if mv['state'] == 'HOLD':
+        return '<p class="mv" data-slot="movement">%s %s. Reason: %s.</p>' % (_pill('HOLD', 'hold'), _e(mv['text']), _e(mv['reason']))
+    return '<p class="mv" data-slot="movement">%s</p>' % _e('Next: ' + mv['verbs'][0])
+
+
+# ---------------------------------------------------------------------------------------------- enhance slots
+def _slot_made_of(m):
+    mo = m['enhance']['made_of']
+    if not mo:
+        return '<div data-slot="made_of"><h2>Made of</h2><p class="sb">%s</p></div>' % _e(NO_ROLES)
+    if not mo['rows']:
+        body = '<p class="sb">No roles returned.</p>'
+    else:
+        rows = ''
+        for r in mo['rows']:
+            req = _pill('required', 'req') if r['required'] else _pill('optional')
+            many = _pill('one or more') if r['many'] else ''
+            rows += _kv(r['name'], '%s%s%s %s' % (req, many, _e(str(r['bound_label'])), _pill(r['bound_status'] or 'UNSOURCED')))
+        body = '<div class="cd">%s</div>' % rows
+    return '<div data-slot="made_of"><h2>%s</h2>%s</div>' % (_e(mo['heading']), body)
+
+
+def _peer_state(p):
+    if p.get('operating_source') == 'SOURCED':
+        return '%s existence only, not operation' % _pill('CATALOGUE RECORD FOUND', 'req')
+    return _pill('NO OPERATING SOURCE: HOLD', 'hold')
+
+
+def _slot_peers(m):
+    pe = m['enhance'].get('peers')
+    if not pe:
+        return '<div data-slot="peers"><h2>Linked peers</h2><p class="sb">No linked peers are declared for this screen.</p></div>'
+    rows = ''
+    for p in pe['rows']:
+        more = '<details><summary>what it is</summary><div>%s</div></details>' % _t(p.get('definition'))
+        rows += _kv(p['label'], '%s %s %s' % (_pill(p['status'] or 'UNSOURCED'), _peer_state(p), more))
+    return '<div data-slot="peers"><h2>%s</h2><div class="cd">%s</div></div>' % (_e(pe['heading']), rows)
+
+
+# ----------------------------------------------------------------------------------------------- enrich slots
+def _chips_cell(r):
+    shown, rest = r['chips'][:3], r['chips'][3:]
+    if not r['chips']:
+        line = 'None recorded'
+    else:
+        line = ' '.join(_pill(_chip_text(c)) for c in shown)
+        if rest:
+            line += _e(' +%d' % len(rest))
+    full = ''
+    if r.get('evidence') or r.get('full_citation') or r['chips']:
+        items = ''.join('<li>%s</li>' % _e(_chip_text(c)) for c in r['chips'])
+        ev = ''.join('<li>Evidence: %s</li>' % _e(str(e.get('label') or e.get('source_ref'))) for e in r.get('evidence') or [])
+        fc = ('<p class="sb">Definition source: %s</p>' % _e(str(r['full_citation']))) if r.get('full_citation') else ''
+        full = '<details><summary>full citation</summary><div><ul>%s%s</ul>%s</div></details>' % (items, ev, fc)
+    return '<div>%s</div>%s' % (line, full)
+
+
+def _status_cell(r):
+    """One line: status pill, then the one-line qualifier. Anything longer is behind a disclosure."""
+    cls = 'hold' if r['status'] == 'HOLD' else ('req' if r['status'] == 'CATALOGUE RECORD FOUND' else '')
+    line = _pill(r['status'] or 'UNSOURCED', cls)
+    q = r.get('qualifier')
+    if q and q.get('first'):
+        line += ' ' + _e(str(q['first']))
+    if r.get('rejected'):
+        line += ' ' + _e('Rejected evidence: ' + ', '.join(r['rejected']))
+    s = '<div>%s</div>' % line
+    if q and q.get('first'):
+        full = q.get('full')
+        if isinstance(full, list) and len(full) > 1:
+            s += '<details><summary>%s</summary><div><ul>%s</ul></div></details>' % (
+                _e('+%d more' % (len(full) - 1)), ''.join('<li>%s</li>' % _e(str(x)) for x in full[1:]))
+        elif isinstance(full, str) and full != str(q['first'])[len('Kind: '):]:
+            s += '<details><summary>full kind</summary><div>%s</div></details>' % _e(full)
+    return s
+
+
+def _open_cell(r):
+    n = len(r['open'])
+    if not n:
+        return '<div>none recorded</div>'
+    first = r['open'][0]
+    stem = _e(first['stem'] + '…') + ' ' if first['truncated'] else ''
+    return '<div>%s%s</div>' % (stem, _e('(%d open)' % n))
+
+
+def _slot_trust_table(m):
+    rows = ''.join('<tr data-claim="%s"><td><div>%s</div></td><td>%s</td><td>%s</td><td>%s</td></tr>' % (
+        _e(r['id']), _e(r['label']), _status_cell(r), _chips_cell(r), _open_cell(r)) for r in m['enrich']['rows'])
+    return ('<div data-slot="trust_table"><h2>Why to trust it</h2><div class="cd"><table class="tt"><thead><tr><th>Claim</th><th>Status</th>'
+            '<th>Source</th><th>Open question</th></tr></thead><tbody>%s</tbody></table></div></div>' % rows)
+
+
+def _slot_open_questions(m):
+    items = ''
+    for r in m['enrich']['rows']:
+        if r['open']:
+            items += '<li>%s (%s)<ul>%s</ul></li>' % (_e(r['label']), _e('%d open' % len(r['open'])),
+                                                      ''.join('<li>%s</li>' % _e(q['text']) for q in r['open']))
+    body = '<ul>%s</ul>' % items if items else '<p class="sb">none recorded</p>'
+    return '<div data-slot="open_questions"><h2>What is still open</h2><div class="cd">%s</div></div>' % body
+
+
+def _slot_technical(m):
+    t = m['enrich']['technical']
+    td = _kv('Registry', _e('%s, %s, fingerprint %s' % (m.get('registry_version', ''), m.get('registry_state', ''), str(m.get('registry_sha', ''))[:12])))
+    if t.get('relationship') and t.get('cluster_id'):
+        td += _kv('Roles come from', _e('relationship %s, cluster %s' % (t['relationship'], t['cluster_id'])))
+    for e in t.get('evidence_sources') or []:
+        td += _kv('Evidence source', _e('%s, fingerprint %s' % (e.get('source_ref', ''), str(e.get('sha256', ''))[:12])))
+    td += _kv('Screen declaration', _e('%s, fingerprint %s' % (t.get('screen_id', ''), str(m.get('declaration_sha', ''))[:12])))
+    if t.get('kind'):
+        td += _kv('Bound kind', _e(str(t['kind'])))
+    return '<details class="td" data-slot="technical"><summary>Technical details</summary><div class="cd">%s</div></details>' % td
+
+
+SLOT_BUILDERS = {
+    'header': _slot_header, 'answer': _slot_answer, 'trust': _slot_trust, 'movement': _slot_movement,
+    'made_of': _slot_made_of, 'peers': _slot_peers,
+    'trust_table': _slot_trust_table, 'open_questions': _slot_open_questions, 'technical': _slot_technical,
+}
+
+
+def render_unavailable(out, title='Screen'):
+    why = (out or {}).get('reason', 'UNKNOWN') if isinstance(out, dict) else 'UNKNOWN'
+    return STYLE + '<div class="syn-sc">%s<h1>%s</h1><p class="sb">Not available: %s.</p></div>' % (BACK, _e(title), _e(str(why)))
+
+
+def render_screen(m):
+    """One renderer for every screen. Slots are built in the order the model lists them (frame first, then each depth)."""
+    if not isinstance(m, dict) or m.get('result') != 'OK' or 'slots' not in m:
+        return render_unavailable(m)
+    eff = m['depth_effective']
+    h = STYLE + '<div class="syn-sc" data-screen="%s" data-screen-type="%s" data-depth="%s">' % (_e(m['screen']), _e(m['screen_type']), _e(eff)) + BACK
+    for slot in m['slots']:
+        h += SLOT_BUILDERS[slot](m)
+    na = m.get('not_applicable')
+    if na:
+        h += '<div class="cd" data-slot="not_applicable">%s: %s (%s).</div>' % (_e(LABEL[na['requested']]), _e(na['text']), _e(na['reason']))
+    note = DEPTH_NOTE.get(eff, '')
+    if m.get('depth_clamped') and m.get('clamp_reason') == 'role':
+        note += ' (Your role limits the depth to %s.)' % LABEL[eff]
+    h += '<p class="nt">%s Registry %s, %s. Presentation only: this view changes no data, kind, PPV, approval or right.</p></div>' % (
+        _e(note), _e(str(m.get('registry_version', ''))), _e(str(m.get('registry_state', ''))))
+    return h
